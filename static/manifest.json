{
  "manifest_version": 3,
  "name": "LinkedIn Tidy",
  "description": "Two-column, shadcn-styled LinkedIn without the clutter.",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin.user.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
